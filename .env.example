# Public Supabase connection values from Project > Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Used only by trusted server actions / webhook ingestion.
# Never prefix this with NEXT_PUBLIC_. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical app origin. For Meta webhook override this must be a public HTTPS URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API / Meta Graph API
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Growth AI: server-only Responses API configuration. Both values are required.
# Use a model available to your OpenAI project with Structured Outputs support.
OPENAI_API_KEY=
OPENAI_MODEL=
