# Public Supabase connection values from Project > Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Used only by trusted server actions for tenant bootstrap / member administration.
# Never prefix this with NEXT_PUBLIC_. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical app origin, used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future production adapters
OPENAI_API_KEY=
OPENAI_MODEL=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
